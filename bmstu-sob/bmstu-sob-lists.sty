\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bmstu-sob-lists}[2026/09/21 v1.1.0 GOST enumeration and lists]

\RequirePackage{enumitem}
\RequirePackage{etoolbox}

% List content remains in the 14 pt TNR body font. The dash or number starts
% at the normal paragraph text position and no extra vertical space is added.
\setlist[itemize]{%
  label=\textendash,
  leftmargin=12.5mm,
  labelindent=0mm,
  labelsep=0.5em,
  itemindent=0mm,
  listparindent=12.5mm,
  parsep=0pt,
  partopsep=0pt,
  topsep=0pt,
  itemsep=0pt,
  align=left,
  before=\justifying,
  font=\normalfont
}

\setlist[enumerate]{%
  label=\arabic*),
  leftmargin=12.5mm,
  labelindent=0mm,
  labelsep=0.5em,
  itemindent=0mm,
  listparindent=12.5mm,
  parsep=0pt,
  partopsep=0pt,
  topsep=0pt,
  itemsep=0pt,
  align=left,
  before=\justifying,
  font=\normalfont
}

\newenvironment{bmstualpha}{%
  \begin{enumerate}[label=\asbuk*),leftmargin=12.5mm,labelsep=0.5em,itemsep=0pt,topsep=0pt,parsep=0pt,partopsep=0pt,listparindent=12.5mm]
}{%
  \end{enumerate}
}

\newenvironment{bmstuenumerate}{\begin{enumerate}}{\end{enumerate}}
\newenvironment{bmstuitemize}{\begin{itemize}}{\end{itemize}}

% Term/definition lists: label at the left, explanation starts after a stable gap.
\newlist{bmstutermlist}{description}{1}
\setlist[bmstutermlist]{%
  style=multiline,
  leftmargin=0pt,
  labelindent=0pt,
  labelwidth=0pt,
  labelsep=0.6em,
  itemindent=0pt,
  align=left,
  font=\normalfont,
  parsep=0pt, partopsep=0pt, topsep=0pt, itemsep=0pt
}
\newcommand{\bmstuterm}[2]{\item[\textnormal{#1}]\hspace{0.25\linewidth}#2}

\endinput
